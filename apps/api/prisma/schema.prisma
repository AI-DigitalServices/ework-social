generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  password           String?
  name               String
  avatar             String?
  googleId           String?           @unique
  isVerified         Boolean           @default(false)
  verificationToken  String?           @unique
  verificationExpiry DateTime?
  resetToken         String?           @unique
  resetTokenExpiry   DateTime?
  tokenVersion       Int               @default(0)
  isAdmin            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspaces         WorkspaceMember[]
  ownedWorkspaces    Workspace[]
  sentInvites        WorkspaceInvite[]
  referralCode       String?           @unique
  referredById       String?
  referredBy         User?             @relation(name: "UserReferrals", fields: [referredById], references: [id])
  isFoundingPartner  Boolean           @default(false)
  referrals          User[]            @relation(name: "UserReferrals")
  notifications      Notification[]
  assignedClients    Client[]          @relation("AssignedClients")
  assignedMessages   InboxMessage[]
  activityLogs       Activity[]
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  logo            String?
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id])
  members         WorkspaceMember[]
  clients         Client[]
  posts           Post[]
  socialAccounts  SocialAccount[]
  automationRules AutomationRule[]
  invites         WorkspaceInvite[]
  subscription    Subscription?
  postApprovals   PostApproval[]
  inboxMessages   InboxMessage[]
  aiUsage         AiUsage[]

  // AI Operating System (Phase 1) - off by default; shadow-mode only until a
  // human explicitly enables it. agentPaused is the per-workspace kill switch,
  // checked at the top of every orchestrator run regardless of agentEnabled.
  agentEnabled Boolean           @default(false)
  agentPaused  Boolean           @default(false)
  campaigns    Campaign[]
  agentRuns    AgentRun[]
  memories     WorkspaceMemory[]
  assets       Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(VIEWER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model Subscription {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  plan        Plan      @default(FREE)
  status      SubStatus @default(ACTIVE)
  paystackRef String?
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SocialAccount {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  platform     Platform
  accountName  String
  accountId    String
  accessToken  String?
  refreshToken String?
  isActive     Boolean   @default(true)
  posts        Post[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, platform, accountId])
}

model Post {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  content         String
  mediaUrls       String[]
  status          PostStatus    @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  errorMessage    String?
  externalId      String?

  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  approval     PostApproval?
  campaignTask CampaignTask?
}

model Client {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  name            String
  email           String?
  phone           String?
  company         String?
  tags            String[]
  stage           LeadStage      @default(LEAD)
  source          LeadSource     @default(MANUAL)
  dealValue       Float?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  postApprovals   PostApproval[]
  assignedToId    String?
  assignedTo      User?          @relation("AssignedClients", fields: [assignedToId], references: [id])
  socialProfiles  Json?
  notes           Note[]
  posts           Post[]
  tasks           Task[]
  activities      Activity[]
  inboxMessages   InboxMessage[]
  campaigns       Campaign[]
  assets          Asset[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Task {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  title     String
  dueDate   DateTime?
  isDone    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  STARTER
  GROWTH
  AGENCY_PRO
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
  TIKTOK
  YOUTUBE
  BLUESKY
  THREADS
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  PENDING_APPROVAL
}

enum LeadStage {
  LEAD
  CONTACTED
  PROPOSAL
  ACTIVE
  DORMANT
}

enum LeadSource {
  MANUAL
  INSTAGRAM_DM
  INSTAGRAM_COMMENT
  FACEBOOK_DM
  FACEBOOK_COMMENT
  REFERRAL
  WEBSITE
  OTHER
}

enum ActivityType {
  NOTE_ADDED
  STAGE_CHANGED
  DM_RECEIVED
  COMMENT_RECEIVED
  TASK_CREATED
  TASK_COMPLETED
  EMAIL_SENT
  DEAL_UPDATED
  ASSIGNED
  CREATED
}

model Activity {
  id          String       @id @default(cuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())
}

model AutoResponderRule {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  platform        String
  triggerType     String
  keywords        String[]
  responseMessage String
  responseType    String   @default("comment")
  isActive        Boolean  @default(true)
  updateLeadStage String?
  triggerCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Add these fields to existing Subscription model via raw SQL

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AutomationRule {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  triggerStage LeadStage
  subject      String
  body         String
  replyTo      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  email       String
  role        Role      @default(EDITOR)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?  @default("landing_page")
  createdAt DateTime @default(now())
}

model PostApproval {
  id           String         @id @default(cuid())
  postId       String         @unique
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id])
  clientEmail  String
  clientName   String
  token        String         @unique @default(cuid())
  status       ApprovalStatus @default(PENDING)
  revisionNote String?
  approvedAt   DateTime?
  respondedAt  DateTime?
  emailSentAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

model InboxMessage {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  platform        Platform
  type            InboxMessageType
  externalId      String // comment_id or message_id from Meta
  senderId        String? // sender's platform ID
  senderName      String? // sender's name or username
  senderAvatar    String? // profile picture URL
  content         String // message/comment text
  postId          String? // parent post ID (for comments)
  postContent     String? // snippet of the post being commented on
  isRead          Boolean          @default(false)
  isResolved      Boolean          @default(false)
  tags            String[]         @default([]) // e.g. ["Lead", "VIP", "Support"]
  assignedToId    String?
  assignedTo      User?            @relation(fields: [assignedToId], references: [id])
  crmClientId     String? // linked CRM client record
  crmClient       Client?          @relation(fields: [crmClientId], references: [id])
  aiSuggestion    String? // AI-suggested reply
  replies         InboxReply[]
  socialAccountId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([platform, externalId])
  @@index([workspaceId, isResolved, createdAt])
}

model InboxReply {
  id        String       @id @default(cuid())
  messageId String
  message   InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content   String
  sentAt    DateTime     @default(now())
  sentBy    String? // userId who sent it
  isAuto    Boolean      @default(false)
}

enum InboxMessageType {
  DM
  COMMENT
}

model AiUsage {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  type        AiUsageType
  month       String // e.g. "2026-07"
  count       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([workspaceId, type, month])
  @@index([workspaceId, month])
}

enum AiUsageType {
  CAPTION
  HASHTAG
  REWRITE
  CRM_INSIGHT
  REPLY_SUGGEST
  AGENT_ACTION
  ASSET_UPLOAD
  IMAGE_GEN
}

//  AI Operating System (Phase 1 - additive, shadow-mode) 
// Campaign is the brief the agent works from; CampaignTask is each proposed
// action awaiting human approval; AgentRun is an immutable audit record of
// every reasoning cycle (see AI_OS_Blueprint section 10 - audit is non-
// negotiable); WorkspaceMemory is the "Brand Brain" the agent reads before
// acting. Nothing here auto-publishes: Phase 1 ships in shadow mode only.

enum CampaignStatus {
  DRAFT
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignTaskType {
  STRATEGY
  CONTENT_DRAFT
  OPTIMIZATION
  REPORT
}

enum CampaignTaskStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum AgentRunOutcome {
  SUCCESS
  FAILED
  NEEDS_APPROVAL
}

enum MemoryKind {
  BRAND
  AUDIENCE
  WINNING_CONTENT
  REJECTED
  CAMPAIGN_LEARNING
  COMPETITOR
  DOCUMENT
}

model Campaign {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  clientId      String?
  client        Client?        @relation(fields: [clientId], references: [id])
  goal          String
  brief         String
  platforms     String[]
  status        CampaignStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  budgetActions Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tasks  CampaignTask[]
  runs   AgentRun[]
  assets Asset[]

  @@index([workspaceId, status])
}

model CampaignTask {
  id         String             @id @default(cuid())
  campaignId String
  campaign   Campaign           @relation(fields: [campaignId], references: [id])
  type       CampaignTaskType
  payload    Json
  status     CampaignTaskStatus @default(PROPOSED)
  postId     String?            @unique
  post       Post?              @relation(fields: [postId], references: [id])
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([campaignId, status])
}

model AgentRun {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  campaignId  String?
  campaign    Campaign?       @relation(fields: [campaignId], references: [id])
  trigger     String // e.g. "campaign_wizard", "shadow_test"
  model       String // e.g. "claude-sonnet-4-5"
  toolCalls   Json?
  tokensIn    Int?
  tokensOut   Int?
  costUsd     Float?
  outcome     AgentRunOutcome
  summary     String?
  createdAt   DateTime        @default(now())

  @@index([workspaceId, createdAt])
}

// Plain-text memory for Phase 1 - semantic (pgvector) retrieval lands in
// Phase 2 once the extension is enabled on Neon; reads are keyword/kind-
// filtered until then, which is enough for a single active campaign.
model WorkspaceMemory {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  kind        MemoryKind
  content     String
  sourceRef   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId, kind])
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum AssetSource {
  UPLOADED
  GENERATED
}

// Creative Hub (AI OS v2, section 13.1): single source of truth for every
// marketing asset - uploads and AI-generated output alike. Storage itself is
// the existing Supabase "media" bucket (apps/web/src/lib/supabase.ts
// uploadMedia()); this table is the searchable index on top of it.
// embedding is Voyage voyage-3-lite (512-dim) - Unsupported() because Prisma
// has no native vector type; read/write happens via $queryRaw/$executeRaw
// in AssetsService, everything else uses the normal Prisma Client.
model Asset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])

  kind      AssetKind
  source    AssetSource @default(UPLOADED)
  url       String
  fileName  String?
  mimeType  String?
  sizeBytes Int?

  tags      String[]
  embedding Unsupported("vector(512)")?

  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, kind])
}

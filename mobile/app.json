{
  "expo": {
    "name": "eWork Social",
    "slug": "ework-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eworksocial",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.eworksocial.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1440",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.eworksocial.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080C14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "react-native-compressor",
      [
        "expo-image-picker",
        {
          "photosPermission": "eWork Social needs your photos so you can post them.",
          "cameraPermission": "eWork Social needs the camera so you can take a photo to post.",
          "microphonePermission": "eWork Social needs the microphone so you can record a video with sound."
        }
      ],
      "expo-video",
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "25b3d1cc-26d6-43db-9d89-562285a2e66b"
      }
    },
    "owner": "eworksocial"
  }
}
